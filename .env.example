# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" con valores reales a git (ya esta en .gitignore).
#
# Donde encontrar estos valores:
#   Supabase Dashboard -> Project Settings -> API
#
# VITE_SUPABASE_URL: URL del proyecto de Supabase (ej: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: clave publica "anon" / "public".
# Es segura de exponer en el frontend porque el acceso real a los datos
# esta controlado por las politicas de Row Level Security (RLS) en Supabase.
# NUNCA uses aqui la "service_role key" (esa es secreta y solo debe usarse en backend).
VITE_SUPABASE_ANON_KEY=